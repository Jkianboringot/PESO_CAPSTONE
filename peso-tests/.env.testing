# .env.testing — PESO Connect Test Environment
# ═══════════════════════════════════════════════
# WHY THIS FILE EXISTS:
# Laravel checks for .env.testing when APP_ENV=testing is set.
# This file overrides your regular .env for all test runs.
# This means you can run tests safely without any risk of:
# - Writing to your real development database
# - Sending real emails to residents or PESO staff
# - Consuming real cache entries
#
# HOW TO GENERATE APP_KEY:
# php artisan key:generate --env=testing
# Then paste the output below.

APP_NAME="PESO Connect (Test)"
APP_ENV=testing
APP_KEY=base64:REPLACE_WITH_OUTPUT_OF_php_artisan_key_generate
APP_DEBUG=true
APP_URL=http://localhost

# ── Database: SQLite in-memory ────────────────────────────────────
# :memory: means the database exists only while the PHP process runs.
# It is created fresh for every php artisan test invocation.
# No cleanup needed. No migration rollback needed. Zero risk to real data.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# ── Cache, Session, Queue, Mail: All in-memory/array ─────────────
# array = no disk writes, no Redis, no database rows.
# Everything is ephemeral and isolated to the current test process.
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
